
config

+ parent-provides
  + service CPU
  + service PD
  + service RM
  + service ROM
  + service LOG
+ default-route
  + service CPU | + parent
  + service PD  | + parent
  + service RM  | + parent
  + service LOG | + parent
  + service Timer | + child timer
+ default | caps: 128 | ram: 4M
+ start timer
  + provides | + service Timer
  + route | + any-service | + parent

+ start writfs | caps: 256 | ram: 128M
  + provides
    + service File_system
    + service Writ_control
  + config | reader: reader -> / | size: 33 | controller: reader -> control
    + libc | stdout: /dev/log | stderr: /dev/log
    + vfs | + dir dev | + log
  + route
    + service ROM | unscoped_label: writfs | + parent
    + service ROM | label: writfs | + parent
    + service ROM | unscoped_label: ld.lib.so | + parent
    + service ROM | label: ld.lib.so | + parent
    + service ROM | unscoped_label: libc.lib.so | + parent
    + service ROM | label: libc.lib.so | + parent
    + service ROM | unscoped_label: libm.lib.so | + parent
    + service ROM | label: libm.lib.so | + parent
    + service ROM | unscoped_label: vfs.lib.so | + parent
    + service ROM | label: vfs.lib.so | + parent
    + service ROM | unscoped_label: mount.mjs | + parent
    + service ROM | label: mount.mjs | + parent
    + service ROM | unscoped_label: canary | + parent
    + service ROM | label: canary | + parent

    + service CPU | + parent
    + service PD  | + parent
    + service RM  | + parent
    + service LOG | + parent
    + service Timer | + child timer


+ start reader | caps: 128 | ram: 8M

  + binary test_writfs
  + config | role: reader
  + route
    + service File_system | + child writfs
    + service Writ_control | + child writfs
    + service ROM | unscoped_label: test_writfs | + parent
    + service ROM | label: test_writfs | + parent
    + service ROM | unscoped_label: ld.lib.so | + parent
    + service ROM | label: ld.lib.so | + parent

    + service CPU | + parent
    + service PD  | + parent
    + service RM  | + parent
    + service LOG | + parent
    + service Timer | + child timer

+ start stranger | caps: 128 | ram: 8M

  + binary test_writfs
  + config | role: stranger
  + route
    + service File_system | + child writfs
    + service ROM | unscoped_label: test_writfs | + parent
    + service ROM | label: test_writfs | + parent
    + service ROM | unscoped_label: ld.lib.so | + parent
    + service ROM | label: ld.lib.so | + parent

    + service CPU | + parent
    + service PD  | + parent
    + service RM  | + parent
    + service LOG | + parent
    + service Timer | + child timer

+ start forger | caps: 128 | ram: 8M

  + binary test_writfs
  + config | role: forger
  + route
    + service File_system | + child writfs
    + service ROM | unscoped_label: test_writfs | + parent
    + service ROM | label: test_writfs | + parent
    + service ROM | unscoped_label: ld.lib.so | + parent
    + service ROM | label: ld.lib.so | + parent

    + service CPU | + parent
    + service PD  | + parent
    + service RM  | + parent
    + service LOG | + parent
    + service Timer | + child timer

